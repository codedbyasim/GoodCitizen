{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "good-citizen-app",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "entry": "splash.html"
      },
      "game": {
        "entry": "game.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "menu": {
    "items": [
      {
        "label": "📋 Create GoodCitizen Leaderboard",
        "description": "Create a new GoodCitizen community leaderboard post",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-create"
      },
      {
        "label": "🎁 Award GoodCitizen Points",
        "description": "Award GoodCitizen points to a community member",
        "location": ["post", "comment"],
        "forUserType": "moderator",
        "endpoint": "/internal/menu/award-points"
      }
    ]
  },
  "forms": {
    "awardPointsForm": "/internal/form/award-submit"
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install",
    "onPostCreate": "/internal/triggers/on-post-create",
    "onCommentCreate": "/internal/triggers/on-comment-create"
  },
  "scheduler": {
    "tasks": {
      "dailyLeaderboardRefresh": {
        "endpoint": "/internal/scheduler/daily-refresh",
        "cron": "0 0 * * *"
      }
    }
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  },
  "dev": {
    "subreddit": "good_citizen_app_dev"
  }
}